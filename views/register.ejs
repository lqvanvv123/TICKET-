<!DOCTYPE html>
<%# Trang đăng ký công khai cho user; quyền staff/admin được cấp ở trang quản lý tài khoản. %>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <script src="/js/icons.js" defer></script>
  <script src="/js/ui.js" defer></script>
  <title>Đăng ký — Bàn hỗ trợ IT</title>
</head>
<body>
  <%- include('partials/feedback') %>
  <div class="auth-shell">
    <div class="auth-card">
      <p class="auth-mark">BÀN HỖ TRỢ IT</p>
      <h2 class="auth-title">Tạo tài khoản</h2>

      <div class="card ticket-stub">
        <% if (error) { %> <p class="error-box" role="alert"><%= error %></p> <% } %>

        <%# Gửi ba ô cho server kiểm tra mật khẩu và nhập lại; minlength chỉ là hỗ trợ phía trình duyệt. %>
        <form action="/register" method="POST" data-loading-text="?ang t?o t?i kho?n?">
          <div class="field">
            <label for="username">Tên đăng nhập</label>
            <input type="text" id="username" name="username" value="<%= typeof formValues !== 'undefined' ? formValues.username : '' %>" required autofocus>
            <%- include('partials/field-error', { name: 'username' }) %>
          </div>
          <div class="field">
            <label for="password">Mật khẩu</label>
            <input type="password" id="password" name="password" required minlength="6">
            <%- include('partials/field-error', { name: 'password' }) %>
          </div>
          <div class="field">
            <label for="confirmPassword">Nhập lại mật khẩu</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6">
            <%- include('partials/field-error', { name: 'confirmPassword' }) %>
          </div>
          <button type="submit" class="btn btn-primary">Đăng ký</button>
        </form>

        <p class="switch-line">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
      </div>
    </div>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Bảng Kanban — Bàn hỗ trợ IT</title>
</head>
<body>
  <%- include('partials/admin-sidebar') %>
  <div class="container container-wide has-sidebar">
    <%- include('partials/admin-header', { pageTitle: 'Bảng Kanban' }) %>

    <div class="board">
      <% columns.forEach(col => { %>
        <div class="board-col" data-status="<%= col.status %>">
          <div class="board-col-head">
            <span class="stamp stamp-<%= col.slug %>"><%= col.status %></span>
            <span class="board-count"><%= col.tickets.length %></span>
          </div>
          <div class="board-col-body" data-dropzone>
            <% col.tickets.forEach(t => { %>
              <%- include('partials/board-card', { t }) %>
            <% }) %>
            <% if (col.tickets.length === 0) { %>
              <div class="board-empty">Không có yêu cầu</div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <%- include('partials/chat-widget-admin') %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/realtime.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/admin-actions.js"></script>
  <script src="/js/board.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/chat-admin.js"></script>
</body>
</html>

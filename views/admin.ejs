<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Bàn làm việc IT — Bàn hỗ trợ IT</title>
</head>
<body>
  <%- include('partials/admin-sidebar') %>
  <div class="container has-sidebar">
    <%- include('partials/admin-header', { pageTitle: 'Danh sách yêu cầu' }) %>

    <div class="card">
      <h3>Yêu cầu cần xử lý</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Mã</th>
              <th>Người gửi</th>
              <th>Tiêu đề</th>
              <th>Loại</th>
              <th>Ưu tiên</th>
              <th>Đính kèm</th>
              <th>Trạng thái</th>
              <th>Cập nhật</th>
            </tr>
          </thead>
          <tbody id="ticketTbody">
            <% tickets.forEach(t => { %>
              <%- include('partials/admin-ticket-row', { t }) %>
            <% }) %>
            <% if (tickets.length === 0) { %>
              <tr class="empty-row" id="emptyRow"><td colspan="8">Chưa có yêu cầu nào được gửi.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="history-modal" id="historyModal" hidden>
    <div class="history-box" role="dialog" aria-modal="true" aria-labelledby="historyTitle">
      <div class="history-box-head">
        <div>
          <h3 id="historyTitle">Lịch sử trạng thái</h3>
          <p class="history-sub" id="historySub"></p>
        </div>
        <button type="button" class="history-close" id="historyClose" aria-label="Đóng">✕</button>
      </div>
      <ol class="history-timeline" id="historyList"></ol>
    </div>
  </div>
  <%- include('partials/chat-widget-admin') %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/realtime.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/admin-actions.js"></script>
  <script src="/js/admin-list.js"></script>
  <script src="/js/history.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/chat-admin.js"></script>
</body>
</html>

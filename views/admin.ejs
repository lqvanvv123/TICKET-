<!DOCTYPE html>
<%# Bộ lọc nằm ngoài ticketListContent để cập nhật realtime không làm mất nội dung đang nhập. %>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/tickets.css">
  <link rel="stylesheet" href="/ticket-list.css">
  <script src="/js/icons.js" defer></script>
  <script src="/js/ui.js" defer></script>
  <script src="/js/deadlines.js" defer></script>
  <title>Bàn làm việc IT — Bàn hỗ trợ IT</title>
</head>
<body data-role="<%= user.role %>" data-user-id="<%= user.id %>" data-list-url="<%= listUrl %>" data-filter-invalid="<%= filterError ? 'true' : 'false' %>">
  <%- include('partials/feedback') %>
  <%- include('partials/admin-sidebar') %>
  <main class="container container-wide has-sidebar ticket-list-workspace">
    <%- include('partials/admin-header', { pageTitle: 'Danh sách yêu cầu' }) %>
    <%- include('partials/page-head', {
      title: 'Yêu cầu cần xử lý',
      hint: 'Tìm yêu cầu, theo dõi hạn và cập nhật công việc của bạn.',
      count: pagination.total
    }) %>
    <section class="card ticket-filter-card" aria-label="Tìm kiếm và bộ lọc">
      <details class="ticket-filter-panel" open>
        <summary class="ticket-filter-toggle">Tìm kiếm &amp; bộ lọc <span><%= activeFilters.length ? activeFilters.length + ' điều kiện đang áp dụng' : 'Tìm theo tiêu đề, mã hoặc người xử lý' %></span></summary>
        <%- include('partials/ticket-filters') %>
        <p class="deadline-hint">Ngày tạo và hạn theo giờ Việt Nam. Sắp đến hạn: còn tối đa 24 giờ.</p>
      </details>
    </section>
    <% if (filterError) { %><p class="error-box" role="alert"><%= filterError %> Vui lòng chọn lại bộ lọc.</p><% } %>
    <div class="ticket-list-sync"><span id="listSync" role="status">Dữ liệu đã sẵn sàng</span><button class="btn btn-ghost" id="listRefresh" type="button"><%- include('partials/icon', { name: 'history' }) %>Làm mới</button></div>
    <div id="ticketListContent"><%- include('partials/admin-ticket-list') %></div>
  </main>
  <div class="history-modal" id="historyModal" hidden>
    <div class="history-box" role="dialog" aria-modal="true" aria-labelledby="historyTitle">
      <div class="history-box-head">
        <div><h3 id="historyTitle">Lịch sử trạng thái</h3><p class="history-sub" id="historySub"></p></div>
        <button type="button" class="history-close" id="historyClose" aria-label="Đóng"><%- include('partials/icon', { name: 'x' }) %></button>
      </div>
      <ol class="history-timeline" id="historyList"></ol>
    </div>
  </div>
  <%- include('partials/chat-widget-admin') %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/realtime.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/admin-actions.js"></script>
  <script src="/js/admin-list.js"></script>
  <script src="/js/history.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/chat-admin.js"></script>
</body>
</html>

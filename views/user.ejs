<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Yêu cầu của tôi — Bàn hỗ trợ IT</title>
</head>
<body>
  <%- include('partials/sidebar') %>
  <div class="container has-sidebar">
    <div class="topbar">
      <div>
        <p class="topbar-eyebrow">Bàn hỗ trợ IT</p>
        <h2>Yêu cầu của tôi</h2>
      </div>
      <div class="topbar-actions">
        <span class="user-tag">Đăng nhập với <b><%= user.username %></b></span>
        <%- include('partials/notif-bell', { notifications }) %>
        <a href="/logout" class="logout-link">Đăng xuất</a>
      </div>
    </div>


    <div class="card">
      <details class="new-ticket-toggle" <%= formError ? 'open' : '' %>>
        <summary class="new-ticket-summary">➕ Tạo yêu cầu mới</summary>
        <div class="new-ticket-body">
          <% if (formError) { %> <p class="error-box"><%= formError %></p> <% } %>
          <form action="/user/ticket" method="POST" enctype="multipart/form-data">
            <div class="field">
              <label for="title">Tiêu đề lỗi</label>
              <input type="text" id="title" name="title" placeholder="VD: Máy in không in được" required>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="requestType">Loại yêu cầu</label>
                <select id="requestType" name="requestType">
                  <% Object.values(REQUEST_TYPE).forEach(rt => { %>
                    <option value="<%= rt %>" <%= rt === REQUEST_TYPE.OTHER ? 'selected' : '' %>><%= rt %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field">
                <label for="priority">Mức độ ưu tiên</label>
                <select id="priority" name="priority">
                  <% Object.values(PRIORITY).forEach(p => { %>
                    <option value="<%= p %>" <%= p === PRIORITY.MEDIUM ? 'selected' : '' %>><%= p %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="description">Mô tả chi tiết</label>
              <textarea id="description" name="description" placeholder="Lỗi xảy ra khi nào, trên máy nào, đã thử làm gì..." required></textarea>
            </div>
            <div class="field">
              <label for="attachments">Đính kèm ảnh/tài liệu (tối đa 5 file, mỗi file ≤ 5MB)</label>
              <input type="file" id="attachments" name="attachments" multiple accept="image/*,.pdf,.doc,.docx,.txt">
            </div>
            <button type="submit" class="btn btn-primary" style="width: auto; padding-left: 22px; padding-right: 22px;">Gửi yêu cầu</button>
          </form>
        </div>
      </details>
    </div>

    <div class="card">
      <h3>Lịch sử yêu cầu</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Tiêu đề</th>
              <th>Loại</th>
              <th>Ưu tiên</th>
              <th>Đính kèm</th>
              <th>Trạng thái</th>
              <th>Ngày gửi</th>
            </tr>
          </thead>
          <tbody id="ticketTbody">
            <% tickets.forEach(t => { %>
              <tr data-ticket-id="<%= t._id %>">
                <td>
                  <div class="ticket-title"><%= t.title %></div>
                  <div class="ticket-desc"><%= t.description %></div>
                </td>
                <td><span class="type-badge type-<%= REQUEST_TYPE_SLUG[t.requestType] %>"><%= t.requestType %></span></td>
                <td><span class="prio-badge prio-<%= PRIORITY_SLUG[t.priority] %>"><%= t.priority %></span></td>
                <td><%- include('partials/attachments', { attachments: t.attachments }) %></td>
                <td><span class="stamp stamp-<%= STATUS_SLUG[t.status] %> js-stamp"><%= t.status %></span></td>
                <td class="ticket-date"><%= new Date(t.createdAt).toLocaleString('vi-VN') %></td>
              </tr>
            <% }) %>
            <% if (tickets.length === 0) { %>
              <tr class="empty-row" id="emptyRow"><td colspan="6">Bạn chưa gửi yêu cầu nào — điền vào form phía trên để gửi yêu cầu đầu tiên.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <%- include('partials/chat-widget-user') %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/realtime.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/user-live.js"></script>
  <script src="/js/sidebar.js"></script>
  <script src="/js/chat-user.js"></script>
</body>
</html>

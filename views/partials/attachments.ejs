<%# Chỉ tạo khối đính kèm khi có file; URL trỏ đến file, originalName là tên người dùng nhìn thấy. %>
<%# Mở tab mới với noopener/noreferrer để hạn chế liên hệ từ tab mới về trang gốc. %>
<% if (attachments && attachments.length) { %>
  <div class="attach-list">
    <% attachments.forEach(a => { %>
      <a class="attach-chip" href="<%= a.url %>" target="_blank" rel="noopener noreferrer" title="<%= a.originalName %>">
        <%- include('icon', { name: 'attach-file' }) %> <span class="attach-name"><%= a.originalName %></span>
      </a>
    <% }) %>
  </div>
<% } %>

<div class="topbar">
  <div>
    <p class="topbar-eyebrow">Bàn hỗ trợ IT</p>
    <h2><%= pageTitle %></h2>
  </div>
  <div class="topbar-actions">
    <span class="user-tag">Đăng nhập với <b><%= user.username %></b></span>
    <button class="bell-btn" type="button" aria-label="Thông báo chưa đọc">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M13.7 21a2 2 0 0 1-3.4 0" stroke-linecap="round"/>
      </svg>
      <span class="bell-count" id="notif-count" data-zero="<%= notifications.length === 0 %>"><%= notifications.length %></span>
    </button>
    <a href="/logout" class="logout-link">Đăng xuất</a>
  </div>
</div>

<%- include('admin-nav', { activeTab }) %>

<% if (notifications.length > 0) { %>
  <div class="card notif-card">
    <h3>Thông báo mới</h3>
    <% notifications.forEach(n => { %>
      <div class="notif-row">
        <div>
          <span class="notif-text"><%= n.message %></span>
          <span class="notif-time"><%= new Date(n.createdAt).toLocaleString('vi-VN') %></span>
        </div>
        <form action="/notifications/<%= n._id %>/read" method="POST">
          <button type="submit" class="btn btn-ghost">Đã đọc</button>
        </form>
      </div>
    <% }) %>
    <div class="notif-actions">
      <form action="/notifications/read-all" method="POST">
        <button type="submit" class="btn btn-ghost">Đánh dấu tất cả đã đọc</button>
      </form>
    </div>
  </div>
<% } %>
